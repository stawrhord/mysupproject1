FROM golang:1.27.1-alpine3.24 AS build

WORKDIR /src

RUN apt-get update \
 && apt-get install -y --no-install-recommends \
      libkrb5-dev ca-certificates \
 && rm -rf /var/lib/apt/lists/*

COPY go.mod go.sum ./
RUN go mod download

COPY . .

FROM scratch

WORKDIR /app

COPY --from=build /out/app /app/app

USER 1000:1000

EXPOSE 8080

ENTRYPOINT ["/app/app"]